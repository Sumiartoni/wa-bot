NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=file:../data/sqlite/jokitugasku.db
JWT_SECRET=change-this-long-random-secret
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Seed Admin

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=JokiTugasKu Support AI
AI_CONFIDENCE_THRESHOLD=0.8
AI_DEFAULT_ENABLED=false

DATA_DIR=./data
WHATSAPP_SESSION_DIR=./data/whatsapp-sessions
WHATSAPP_SESSION_ENCRYPTION_KEY=
MEDIA_DIR=./data/media
BACKUP_DIR=./data/backups
MESSAGE_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_LIMIT=100
AI_CONTACT_DAILY_LIMIT=25
BACKUP_INTERVAL_MINUTES=0
BACKUP_RETENTION_DAYS=30
MESSAGE_QUEUE_MAX_ATTEMPTS=5
MESSAGE_QUEUE_RETRY_SECONDS=30
AUDIT_REDACTION_KEYS=password,token,secret,csrf,authorization,cookie

ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=
ORDER_WEBHOOK_MAX_ATTEMPTS=5
ORDER_WEBHOOK_BACKOFF_SECONDS=30
